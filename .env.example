# Plantilla de configuración local. Cópiala a .env (ignorado por git) y ajusta lo que necesites:
#   cp .env.example .env
# Todas las variables son opcionales: si no se definen se usan los valores por defecto.
# Precedencia: --base-url (CLI) > variables del entorno (CI) > .env > valores del ambiente.

# Ambiente objetivo. Disponibles: prod, staging (ejemplo; ver AMBIENTES en config/settings.py).
# Los datos de prueba se leen de data/comun y se sobrescriben con data/<TEST_ENV>.
# También se puede elegir por CLI con: pytest --env prod
TEST_ENV=prod

# URL base de la aplicación. Si se deja vacía, se usa la URL del ambiente elegido.
# Ejemplo: BASE_URL=https://www.saucedemo.com
BASE_URL=

# Contraseña común de los usuarios de SauceDemo (data/comun/usuarios.yaml la lee como
# ${SAUCE_PASSWORD:-secret_sauce}). Es pública (la muestra la propia pantalla de login);
# en un proyecto real iría solo en .env o en los secrets de la CI.
SAUCE_PASSWORD=secret_sauce
